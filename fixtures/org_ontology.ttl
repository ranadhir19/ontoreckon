# org-fixture ontology in ontoreckon's Turtle subset.
# Must parse to exactly the same profile as org_ontology.json
# (a validate.py check asserts the two agree).
<ex:Agent> <rdf:type> <owl:Class> .
<ex:Person> <rdf:type> <owl:Class> .
<ex:Person> <rdfs:subClassOf> <ex:Agent> .
<ex:Employee> <rdf:type> <owl:Class> .
<ex:Employee> <rdfs:subClassOf> <ex:Person> .
<ex:Organization> <rdf:type> <owl:Class> .
<ex:City> <rdf:type> <owl:Class> .
<ex:Vehicle> <rdf:type> <owl:Class> .
<ex:Car> <rdf:type> <owl:Class> .
<ex:Car> <rdfs:subClassOf> <ex:Vehicle> .
<ex:Animal> <rdf:type> <owl:Class> .
<ex:Dog> <rdf:type> <owl:Class> .
<ex:Dog> <rdfs:subClassOf> <ex:Animal> .
<ex:Food> <rdf:type> <owl:Class> .
<ex:worksFor> <rdf:type> <owl:ObjectProperty> .
<ex:worksFor> <rdfs:domain> <ex:Person> .
<ex:worksFor> <rdfs:range> <ex:Organization> .
<ex:employs> <rdf:type> <owl:ObjectProperty> .
<ex:employs> <rdfs:domain> <ex:Organization> .
<ex:employs> <rdfs:range> <ex:Person> .
<ex:locatedIn> <rdf:type> <owl:ObjectProperty> .
<ex:locatedIn> <rdfs:domain> <ex:Organization> .
<ex:locatedIn> <rdfs:range> <ex:City> .
<ex:mentors> <rdf:type> <owl:ObjectProperty> .
<ex:mentors> <rdfs:domain> <ex:Person> .
<ex:mentors> <rdfs:range> <ex:Person> .
<ex:owns> <rdf:type> <owl:ObjectProperty> .
<ex:owns> <rdfs:domain> <ex:Person> .
<ex:owns> <rdfs:range> <ex:Vehicle> .
<ex:eats> <rdf:type> <owl:ObjectProperty> .
<ex:eats> <rdfs:domain> <ex:Animal> .
<ex:eats> <rdfs:range> <ex:Food> .
<ex:hasManager> <rdf:type> <owl:ObjectProperty> .
<ex:hasManager> <rdfs:domain> <ex:Employee> .
<ex:hasManager> <rdfs:range> <ex:Person> .
<ex:hasManager> <ontoreckon:maxCardinality> "1" .
<ex:Person> <owl:disjointWith> <ex:Organization> .
